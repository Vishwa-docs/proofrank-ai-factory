BRIGHTDATA_API_TOKEN=replace_with_bright_data_token
BRIGHTDATA_UNLOCKER_ZONE=mcp_unlocker
# direct, bright-data-request-api default with token, or mcp for Remote MCP
PROOFRANK_FETCH_MODE=mcp
# Optional override; omit to use https://mcp.brightdata.com/mcp?token=BRIGHTDATA_API_TOKEN
BRIGHTDATA_MCP_URL=
# Request the exact Remote MCP tools needed for the final sponsor proof bundle.
BRIGHTDATA_MCP_TOOLS=search_engine,scrape_as_markdown,discover
PROOFRANK_BRIGHTDATA_CAP_USD=20
PROOFRANK_MAX_BRIGHTDATA_CALLS=12
PROOFRANK_REVIEW_TOKEN=replace_with_random_judge_token
PROOFRANK_RECEIPT_SIGNING_SECRET=replace_with_random_receipt_signing_secret
PROOFRANK_ALLOWED_ORIGINS=https://your-app.nativelyai.app,https://proofrank-ai-factory.vercel.app,https://vishwa-docs.github.io
PROOFRANK_ALLOWED_HOSTS=github.com,*.github.io,*.vercel.app,lablab.ai,*.nativelyai.app
PROOFRANK_LIVE_API_URL=https://your-live-api.example/api/review-project

AIMLAPI_KEY=replace_with_aimlapi_key
AIMLAPI_SPEND_CAP_USD=10

SPEECHMATICS_API_KEY=replace_with_speechmatics_key
